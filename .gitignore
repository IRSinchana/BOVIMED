# Model weights (large binary — place best.pt locally)
backend/models/*.pt
backend/models/*.onnx
!backend/models/.gitkeep
!backend/models/README.md

# SQLite database
backend/**/*.db
backend/**/*.sqlite
backend/**/*.sqlite3

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs / temp
*.log
tmp/
temp/
_*.txt
