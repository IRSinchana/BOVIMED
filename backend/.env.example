# DEMO_MODE=true until backend/models/best.pt is available
DEMO_MODE=true
MODEL_PATH=models/best.pt
DATABASE_URL=sqlite:///./bovimed.db
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://bovimed-6qup5l311-i-r-sinchana.vercel.app
HEALTHY_THRESHOLD=0.30
MILD_THRESHOLD=0.55
MODERATE_THRESHOLD=0.75
SEVERE_THRESHOLD=0.90

# BOVIMED AI chatbot (never commit real keys)
BOVIMED_LLM_ENABLED=false
BOVIMED_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
BOVIMED_LLM_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=bovimed-dev-secret-change-in-production

# OTP authentication (set OTP_DEV_MODE=true for local testing without SMS)
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=
OTP_TEMPLATE_ID=
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
