# BOVIMED — Environment Variables
# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# --- Backend ---
# false = real YOLO11 from backend/models/best.pt
# true  = clearly labeled DEMO/MOCK results only
DEMO_MODE=false
MODEL_PATH=models/best.pt
DATABASE_URL=sqlite:///./backend/bovimed.db
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Risk engine thresholds (confidence / score based)
HEALTHY_THRESHOLD=0.30
MILD_THRESHOLD=0.55
MODERATE_THRESHOLD=0.75
SEVERE_THRESHOLD=0.90

# Optional veterinarian / LLM providers (leave empty for safe local mode)
GOOGLE_PLACES_API_KEY=
VET_PROVIDER=
BOVIMED_LLM_API_KEY=
BOVIMED_LLM_ENABLED=false
JWT_SECRET=bovimed-dev-secret-change-in-production

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=false
