# BOVIMED — Environment Variables
# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# --- Backend ---
# false = real YOLO11 from backend/models/best.pt
# true  = clearly labeled DEMO/MOCK results only
DEMO_MODE=false
MODEL_PATH=models/best.pt
DATABASE_URL=sqlite:///./backend/bovimed.db
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://bovimed-6qup5l311-i-r-sinchana.vercel.app

# Risk engine thresholds (confidence / score based)
HEALTHY_THRESHOLD=0.30
MILD_THRESHOLD=0.55
MODERATE_THRESHOLD=0.75
SEVERE_THRESHOLD=0.90

# Optional veterinarian provider
GOOGLE_PLACES_API_KEY=
VET_PROVIDER=

# BOVIMED AI chatbot (backend only — never expose in VITE_* or frontend)
BOVIMED_LLM_ENABLED=false
BOVIMED_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
BOVIMED_LLM_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=bovimed-dev-secret-change-in-production

# OTP authentication (backend only — never expose in VITE_*)
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=
OTP_TEMPLATE_ID=
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_DEV_MODE=true

# Email OTP fallback (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=false
