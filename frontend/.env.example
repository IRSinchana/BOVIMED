# BOVIMED frontend environment (copy to .env.local for local overrides)
#
# Local development (Vite on :5173 / :5174, backend on :8000).
# During `npm run dev`, /api is proxied to this backend (see vite.config.js).
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Production build on Vercel (set in Vercel project env vars):
# VITE_API_BASE_URL=https://bovimed.onrender.com
#
# Note: /media/* is proxied to the backend during `npm run dev` (see vite.config.js).
# Render filesystem is ephemeral — uploaded images may not persist across deploys.
